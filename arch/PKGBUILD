# Maintainer: CharOfString <root@charofstring.cc>
pkgbase=gxde-icon-theme
pkgname=('gxde-icon-theme' 'gxde-sea-icon-theme')
pkgver=2026.03.20
pkgrel=1
pkgdesc='GXDE icon theme'
arch=('any')
url="https://github.com/GXDE-OS/gxde-icon-theme"
license=('GPL-3.0-or-later')
makedepends=('git' 'gtk-update-icon-cache' 'xorg-xcursorgen')
options=('!strip')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # 与 debian/rules 相同：检查图标并用 xcursorgen 生成 loginspinner 光标
  # Same as debian/rules: check the icons and generate the loginspinner
  # cursors with xcursorgen.
  make -C "$(_srcroot)"
}

package_gxde-icon-theme() {
  depends=('adwaita-icon-theme')
  optdepends=('gxde-sea-icon-theme: GXDE Sea icon theme')
  provides=('deepin-icon-theme' "gxde-icon-theme-git=$pkgver")
  conflicts=('deepin-icon-theme' 'gxde-icon-theme-git')
  replaces=('gxde-icon-theme-git')

  # 与 debian/gxde-icon-theme.install 相同 ・ Same as debian/gxde-icon-theme.install.
  install -d "$pkgdir/usr/share/icons"
  cp -r --no-preserve=ownership "$(_srcroot)"/{gxde,deepin,gxde-dark} "$pkgdir/usr/share/icons/"
}

package_gxde-sea-icon-theme() {
  pkgdesc='GXDE Sea icon theme'
  provides=("gxde-sea-icon-theme-git=$pkgver")
  conflicts=('sea-icon-theme' 'gxde-sea-icon-theme-git')
  replaces=('gxde-sea-icon-theme-git')

  install -d "$pkgdir/usr/share/icons"
  cp -r --no-preserve=ownership "$(_srcroot)/gxde-Sea" "$pkgdir/usr/share/icons/"
}
